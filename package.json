{
  "name": "plataforma-indicadores-aps",
  "version": "0.1.0",
  "private": true,
  "description": "Painel APS – Plataforma de Indicadores da Atenção Primária – Secretaria de Saúde de Cajamar",
  "type": "module",
  "scripts": {
    "test": "node --test --no-warnings=ExperimentalWarning \"test/**/*.test.mjs\"",
    "dev": "wrangler pages dev",
    "migrar": "wrangler d1 migrations apply indicadores-aps --remote",
    "deploy": "wrangler d1 migrations apply indicadores-aps --remote && wrangler pages deploy",
    "formatar": "prettier --write \"api/**/*.js\" \"functions/**/*.js\" \"painel/**/*.{js,css,html}\"",
    "formato": "prettier --check \"api/**/*.js\" \"functions/**/*.js\" \"painel/**/*.{js,css,html}\""
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "prettier": "^3.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
